{
  "name": "daybook",
  "version": "1.0.0",
  "description": "A MERN stack application to manage daily journals and tasks",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index",
    "dev": "nodemon src/index",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --reset",
    "validate:data": "node src/scripts/validateData.js",
    "test": "node --test --test-concurrency=1 tests/posts.test.js tests/stage2.test.js tests/stage3.test.js tests/checkins.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theb1ackswordsman/DayBook.git"
  },
  "keywords": [
    "mern",
    "daybook",
    "journal",
    "task",
    "management"
  ],
  "author": "Anirudh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/theb1ackswordsman/DayBook/issues"
  },
  "homepage": "https://github.com/theb1ackswordsman/DayBook#readme",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
